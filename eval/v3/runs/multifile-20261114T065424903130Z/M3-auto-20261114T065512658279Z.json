                {
                  "evidence_id": "ev_0d68767bb73424f12b08c16d3b73038eebe9b660c98c8c1efe606788bf87f6f9",
                  "quote": "import subprocess as proc\n\ndef launch(command_from_user):\n    return proc.run(\n        command_from_user,\n        shell=True,\n        capture_output=True,\n    )\n"
