                  "quote": "    def __init__(\n        self,\n        base_url: str | None = None,\n        api_key: str | None = None,\n        openai_client: AsyncOpenAI | None = None,\n        http_client: _OpenAIHTTPClient | None = None,\n    ) -> None:"
                },
                {
                  "evidence_id": "ev_c903e5c3963ac33824c0f873678f2e57ac5897ad80ccfd673db269a7afda01b2",
                  "quote": "            base_url: The base url for the OpenAI requests. If not provided, the `OPENAI_BASE_URL` environment variable\n                will be used if available. Otherwise, defaults to OpenAI's base url.\n            api_key: The API key to use for authentication, if not provided, the `OPENAI_API_KEY` environment variable\n                will be used if available."
                },
                {
                  "evidence_id": "ev_c903e5c3963ac33824c0f873678f2e57ac5897ad80ccfd673db269a7afda01b2",
                  "quote": "                api_key = 'api-key-not-set'"
                },
                {
                  "evidence_id": "ev_c903e5c3963ac33824c0f873678f2e57ac5897ad80ccfd673db269a7afda01b2",
                  "quote": "        if openai_client is not None:\n            assert base_url is None, 'Cannot provide both `openai_client` and `base_url`'\n            assert http_client is None, 'Cannot provide both `openai_client` and `http_client`'\n            assert api_key is None, 'Cannot provide both `openai_client` and `api_key`'\n            self._client = openai_client\n        else:\n            self._client = self._create_openai_client(base_url=base_url, api_key=api_key, http_client=http_client)"
                }
              ],
              "commit": "e65f5e9ac8ca01ffd1ad8c91d6f5a006d10d250a",
